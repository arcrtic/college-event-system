SECRET_KEY=change-this-to-a-random-string
FLASK_DEBUG=1
ADMIN_PASSCODE=admin123

# DATABASE_URL is intentionally left unset here. If you don't set it,
# config.py falls back to an absolute SQLite path inside this project's
# instance/ folder, which works regardless of your OS or working directory.
# Only set this if you want to point at Postgres/MySQL, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/college_events
